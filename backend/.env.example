# Configurações do Banco de Dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_agent_db
POSTGRES_PORT_EXTERNAL=5433

# Chaves de API de IA [OBRIGATÓRIO]
OPENAI_API_KEY=sua_chave_aqui
GEMINI_API_KEY=sua_chave_aqui
ANTHROPIC_API_KEY=sua_chave_aqui
ASSEMBLYAI_API_KEY=sua_chave_aqui
# Taxa de conversão USD para BRL para exibição de custos
USD_TO_BRL_RATE=6.0

# Configurações de Segurança [OBRIGATÓRIO]
JWT_SECRET_KEY=sua_chave_secreta_jwt
# Chave secreta global (Pepper) para proteção extra de hashes de senhas (mantida fora do banco) [OBRIGATÓRIO]
PASSWORD_PEPPER=sua_chave_secreta_pepper_aqui
AGENT_API_KEY=sua_chave_mestra_api
VITE_AGENT_API_KEY=mesma_chave_mestra_api

# URLs de Comunicação [OBRIGATÓRIO]
# URL pública do backend para redirecionamentos e webhooks
BACKEND_URL=https://sua-api.dominio.com
# URL da API usada pelo frontend (Vite)
VITE_API_URL=https://sua-api.dominio.com
# Origens permitidas para CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5300,https://seu-painel.dominio.com

# Acesso Administrativo Inicial
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=senha_segura

# Integração Google Calendar
GOOGLE_CLIENT_ID=seu_client_id
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_REDIRECT_URI=https://sua-api.dominio.com/integrations/google/callback

# Storage S3/MinIO [OPCIONAL]
# Para desenvolvimento local, usa o MinIO. Em produção, use S3/Backblaze.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=zap-voice
S3_REGION=us-east-1


# Redis/Celery
REDIS_URL=redis://redis:6379/0

# Cloudflare Tunnel (Opcional para Local)
CLOUDFLARE_TUNNEL_URL=https://sua-api.dominio.com
CLOUDFLARE_TUNNEL_TOKEN=seu_token_aqui

# ZapVoice Integration [OBRIGATÓRIO]
# URL da API do ZapVoice
ZAPVOICE_URL=http://localhost:8000
# Token de autorização JWT/API do ZapVoice
ZAPVOICE_API_TOKEN=seu_token_zapvoice_aqui
# URL direta interna (Docker) do ZapVoice para otimização de alta velocidade (10ms) em operações em massa [OPCIONAL]
ZAPVOICE_INTERNAL_URL=http://zapvoice_app:8000

# Retenção de Logs e Expurgos Periódicos [OPCIONAL]
# Quantidade de dias para manter histórico de webhook_events e interaction_logs (default: 60)
LOG_RETENTION_DAYS=60

# Fuso Horário dos Logs e Containers [OPCIONAL]
# Define o fuso horário padrão para emissão de logs e agendamento (default: America/Sao_Paulo)
TZ=America/Sao_Paulo



